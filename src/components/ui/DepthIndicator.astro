---
// Sidebar left — shows layer dots with active state
import { LAYERS } from '../../types';
---

<nav class="depth-indicator" aria-label="Layer navigation">
  <div class="depth-track">
    {LAYERS.map((layer) => (
      <a
        href={`#${layer.id}`}
        class="depth-dot"
        data-layer-dot={layer.id}
        aria-label={`${layer.label} layer`}
      >
        <span class="dot" />
        <span class="dot-label mono">{layer.label}</span>
      </a>
    ))}
  </div>
</nav>

<script>
  import { initDepthTracker, onDepthChange } from '../../scripts/depth-tracker';

  document.addEventListener('DOMContentLoaded', () => {
    const dots = document.querySelectorAll<HTMLElement>('[data-layer-dot]');

    onDepthChange(({ activeLayerId }) => {
      dots.forEach((dot) => {
        const isActive = dot.dataset.layerDot === activeLayerId;
        dot.classList.toggle('is-active', isActive);
        if (isActive) {
          dot.setAttribute('aria-current', 'true');
        } else {
          dot.removeAttribute('aria-current');
        }
      });
    });

    initDepthTracker();

    // Arrow keys / Home / End move focus through the layer links
    const nav = document.querySelector<HTMLElement>('.depth-indicator');
    nav?.addEventListener('keydown', (e) => {
      const keys = ['ArrowDown', 'ArrowUp', 'Home', 'End'];
      if (!keys.includes(e.key)) return;

      const list = Array.from(dots);
      const current = list.indexOf(document.activeElement as HTMLElement);
      if (current === -1) return;

      e.preventDefault();
      let next = current;
      if (e.key === 'ArrowDown') next = Math.min(current + 1, list.length - 1);
      else if (e.key === 'ArrowUp') next = Math.max(current - 1, 0);
      else if (e.key === 'Home') next = 0;
      else if (e.key === 'End') next = list.length - 1;
      list[next].focus();
    });
  });
</script>

<style>
  .depth-indicator {
    position: fixed;
    left: clamp(1rem, 0.75rem + 1.25vw, 2rem);
    top: 50%;
    transform: translateY(-50%);
    z-index: 100;
    display: flex;
    align-items: center;
  }

  .depth-track {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .depth-dot {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    color: var(--layer-surface-text);
    transition: color 0.3s ease;
  }

  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: currentColor;
    opacity: 0.25;
    transition: opacity 0.3s ease, transform 0.3s ease;
    flex-shrink: 0;
  }

  .dot-label {
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    opacity: 0;
    transform: translateX(-4px);
    transition: opacity 0.3s ease, transform 0.3s ease;
    white-space: nowrap;
  }

  .depth-dot.is-active .dot {
    opacity: 1;
    transform: scale(1.5);
  }

  .depth-dot.is-active .dot-label {
    opacity: 1;
    color: #7a8494;
    transform: translateX(0);
  }

  .depth-dot:hover .dot-label,
  .depth-dot:focus-visible .dot-label {
    opacity: 1;
    color: #a0aab8;
    transform: translateX(0);
  }

  /* Mobile: compact dots, no labels — navigation must stay available */
  @media (max-width: 768px) {
    .depth-indicator {
      left: 0.4rem;
    }

    .depth-track {
      gap: 1rem;
    }

    .dot {
      width: 6px;
      height: 6px;
    }

    .dot-label {
      display: none;
    }

    /* Enlarge the touch target beyond the visible dot */
    .depth-dot {
      padding: 0.35rem;
      margin: -0.35rem;
    }
  }
</style>
