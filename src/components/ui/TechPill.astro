---
interface Props {
  label: string;
}

const { label } = Astro.props;
---

<span class="tech-pill mono">{label}</span>

<style>
  .tech-pill {
    display: inline-block;
    padding: 0.2em 0.65em;
    font-size: clamp(0.75rem, 0.7rem + 0.2vw, 0.85rem);
    border: 1px solid currentColor;
    border-radius: 9999px;
    white-space: nowrap;
  }
</style>
