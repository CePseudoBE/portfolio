---
interface Props {
  value: string;
  label: string;
}

const { value, label } = Astro.props;
---

<div class="metric-block">
  <span class="metric-value">{value}</span>
  <span class="metric-label mono">{label}</span>
</div>

<style>
  .metric-block {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .metric-value {
    font-family: 'Instrument Serif', Georgia, serif;
    font-size: clamp(2rem, 1.75rem + 1.25vw, 3.25rem);
    line-height: 1;
  }

  .metric-label {
    font-size: clamp(0.7rem, 0.65rem + 0.2vw, 0.8rem);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    opacity: 0.6;
  }
</style>
