---
interface Props {
  value: string;
  label: string;
}

const { value, label } = Astro.props;

// Extract numeric part and prefix/suffix for counter animation
const match = value.match(/^([~]?)(\d+)(.*)$/);
const prefix = match ? match[1] : '';
const numeric = match ? match[2] : '';
const suffix = match ? match[3] : '';
const hasNumeric = numeric.length > 0;
---

<div class="metric-block">
  <span
    class="metric-value"
    data-metric={hasNumeric ? 'true' : undefined}
    data-metric-prefix={prefix}
    data-metric-target={numeric}
    data-metric-suffix={suffix}
  >
    {value}
  </span>
  <span class="metric-label mono">{label}</span>
</div>

<script>
  // The static HTML always contains the final value. The animation only
  // rewinds to 0 at the moment it starts, so no-JS and reduced-motion
  // visitors never see a zero.
  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (!prefersReduced) {
    document.querySelectorAll<HTMLElement>('[data-metric]').forEach((el) => {
      const target = parseInt(el.dataset.metricTarget || '0', 10);
      const prefix = el.dataset.metricPrefix || '';
      const suffix = el.dataset.metricSuffix || '';

      if (target === 0) return;

      const observer = new IntersectionObserver(
        ([entry]) => {
          if (entry.isIntersecting) {
            observer.disconnect();
            animateCounter(el, target, prefix, suffix);
          }
        },
        { threshold: 0.3 },
      );
      observer.observe(el);
    });
  }

  function animateCounter(
    el: HTMLElement,
    target: number,
    prefix: string,
    suffix: string,
  ): void {
    const duration = 1200;
    const start = performance.now();

    function tick(now: number): void {
      const elapsed = now - start;
      const progress = Math.min(elapsed / duration, 1);
      // Ease out cubic
      const eased = 1 - Math.pow(1 - progress, 3);
      const current = Math.round(eased * target);
      el.textContent = `${prefix}${current}${suffix}`;
      if (progress < 1) requestAnimationFrame(tick);
    }

    requestAnimationFrame(tick);
  }
</script>

<style>
  .metric-block {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .metric-value {
    font-family: 'Instrument Serif', Georgia, serif;
    font-size: clamp(2rem, 1.75rem + 1.25vw, 3.25rem);
    line-height: 1;
  }

  .metric-label {
    font-size: clamp(0.75rem, 0.7rem + 0.2vw, 0.85rem);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #7a8494;
  }
</style>
