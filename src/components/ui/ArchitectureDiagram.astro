---
// SPARC write and read paths as an ordered flow, readable as text without CSS
import { architecturePaths } from '../../data/sparc';
---

<figure class="diagram">
  {architecturePaths.map((path) => (
    <div class="diagram-path">
      <span class="mono path-label">{path.label}</span>
      <ol class="path-nodes">
        {path.nodes.map((node) => (
          <li class="node">
            <span class="mono node-name">{node.name}</span>
            <span class="node-detail">{node.description}</span>
          </li>
        ))}
      </ol>
    </div>
  ))}
  <figcaption class="diagram-caption">
    Around it: Prometheus and Grafana for monitoring, threshold alerts by email,
    asynchronous CSV exports.
  </figcaption>
</figure>

<style>
  .diagram {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .path-label {
    display: block;
    margin-bottom: 0.75rem;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #7a8494;
  }

  .path-nodes {
    list-style: none;
    display: grid;
    gap: 2rem;
  }

  .node {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 0.9rem 1rem;
    border: 1px solid currentColor;
    border-color: color-mix(in srgb, currentColor 25%, transparent);
    border-radius: 4px;
  }

  .node + .node::before {
    content: '↓' / '';
    position: absolute;
    top: -1.75rem;
    left: 50%;
    transform: translateX(-50%);
    color: var(--layer-interface-label);
  }

  .node-name {
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--layer-interface-label);
  }

  .node-detail {
    font-size: 0.85rem;
    line-height: 1.5;
  }

  .diagram-caption {
    font-size: 0.875rem;
  }

  @media (min-width: 769px) {
    .path-nodes {
      grid-template-columns: repeat(4, 1fr);
    }

    .node + .node::before {
      content: '→' / '';
      top: 50%;
      left: -1.4rem;
      transform: translateY(-50%);
    }
  }
</style>
