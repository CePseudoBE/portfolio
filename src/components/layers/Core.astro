---
// Layer 5 — Core: other work, about, contact
import ProjectCard from '../ui/ProjectCard.astro';
import TechPill from '../ui/TechPill.astro';
import Reveal from '../ui/Reveal.astro';
import { projects } from '../../data/projects';
import { skills } from '../../data/skills';
import { contact } from '../../data/contact';

const digitalTwin = projects.find((p) => p.slug === 'digital-twin')!;
const alsoShipped = ['tandem', 'iris', 'infofin'].map(
  (slug) => projects.find((p) => p.slug === slug)!,
);
---

<section class="layer" data-layer="core" id="core">
  <div class="layer-inner core-layout">
    <Reveal><p class="mono layer-label">5 / Core</p></Reveal>

    <div class="core-content">
      <Reveal>
        <div>
          <h2>Other work</h2>
          <ProjectCard project={digitalTwin} />
        </div>
      </Reveal>

      <Reveal>
        <div>
          <h3>Also shipped to production at ULB</h3>
          <ul class="shipped-list">
            {alsoShipped.map((p) => (
              <li class="shipped-item">
                <span class="mono shipped-name">{p.name}</span>
                <span class="shipped-summary">{p.summary}</span>
                <span class="mono shipped-meta">
                  {p.stack.join(' · ')}
                  {p.links?.[0] && (
                    <>
                      {' · '}
                      <a href={p.links[0].href}>{p.links[0].label}</a>
                    </>
                  )}
                </span>
              </li>
            ))}
          </ul>
        </div>
      </Reveal>

      <Reveal>
        <div>
          <h2>About</h2>
          <p class="about-text">
            I build the systems behind the screen: backend services, data pipelines and
            IoT infrastructure. I care about clean architecture, honest engineering and
            software that holds up in production. My rule of thumb: simple until proven
            otherwise.
          </p>
          <p class="about-text">
            Since 2023, I have been a backend engineer at STARI (ULB &amp; FARI) in
            Brussels, working closely with FARI, the AI Institute for the Common Good.
            I reach for Rust when correctness and performance are critical, and
            TypeScript when iteration speed matters more.
          </p>
          <p class="about-text">
            With the FARI AI Academy, I delivered a one-day training session on AI for
            the common good for BELSPO, the Belgian Federal Science Policy Office.
          </p>
        </div>
      </Reveal>

      <Reveal>
        <div>
          <h3>Stack</h3>
          <div class="stack-groups">
            {skills.map((category) => (
              <div class="stack-group">
                <span class="mono stack-label">{category.label}</span>
                <div class="stack-items">
                  {category.items.map((item) => <TechPill label={item} />)}
                </div>
              </div>
            ))}
          </div>
        </div>
      </Reveal>

      <Reveal>
        <div id="contact" class="contact-section">
          <h2>Contact</h2>
          <p class="contact-lead">Open to remote backend roles in the EU.</p>
          <p class="mono contact-email">
            <a href={`mailto:${contact.email}`}>{contact.email}</a>
          </p>
          <div class="contact-actions">
            <a href={`mailto:${contact.email}`} class="button button-primary mono">Email me</a>
            <a href={contact.cv} class="button mono">Download CV (PDF)</a>
            <a href={contact.github} class="button mono">GitHub</a>
            <a href={contact.linkedin} class="button mono">LinkedIn</a>
          </div>
        </div>
      </Reveal>
    </div>

    <footer class="core-footer mono">Built with Astro</footer>
  </div>
</section>

<style>
  .layer-label {
    color: var(--layer-core-label);
    font-size: clamp(0.75rem, 0.7rem + 0.25vw, 0.875rem);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 1.5rem;
  }

  .core-layout {
    display: flex;
    flex-direction: column;
    min-height: calc(100vh - 8rem);
  }

  .core-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  h2 {
    margin-bottom: 1.5rem;
  }

  h3 {
    margin-bottom: 1rem;
  }

  .shipped-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .shipped-item {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding-left: 1rem;
    border-left: 2px solid var(--layer-core-accent);
  }

  .shipped-name {
    font-size: 0.85rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--layer-core-label);
  }

  .shipped-summary {
    font-size: 0.95rem;
  }

  .shipped-meta {
    font-size: 0.75rem;
    color: #7a8494;
  }

  .shipped-meta a {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .shipped-meta a:hover {
    color: var(--layer-core-heading);
  }

  .about-text {
    max-width: 42rem;
    margin-bottom: 1rem;
    font-size: clamp(1rem, 0.95rem + 0.25vw, 1.125rem);
  }

  .stack-groups {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem 2rem;
  }

  .stack-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .stack-label {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #7a8494;
  }

  .stack-items {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  /* Nested wrapping flex rows overflow the viewport on narrow screens
     (the group's intrinsic width is its unwrapped pill row) */
  @media (max-width: 768px) {
    .stack-groups {
      flex-direction: column;
    }

    .stack-group {
      width: 100%;
    }
  }

  .contact-lead {
    font-size: clamp(1.05rem, 1rem + 0.25vw, 1.25rem);
    color: var(--layer-core-heading);
  }

  .contact-email {
    margin-top: 0.5rem;
    font-size: 0.95rem;
  }

  .contact-email a {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .contact-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  .button-primary {
    background-color: var(--layer-core-heading);
    border-color: var(--layer-core-heading);
    color: var(--layer-core-bg);
  }

  .button-primary:hover {
    background-color: var(--layer-core-label);
  }

  .core-footer {
    padding-top: 3rem;
    margin-top: auto;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #7a8494;
  }
</style>
