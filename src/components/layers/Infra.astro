---
// Layer 4 — Infrastructure: SPARC's backend VM, and the OKD GitOps chain for its front-end
import Reveal from '../ui/Reveal.astro';
import { sparcInfra } from '../../data/sparc';
---

<section class="layer" data-layer="infra" id="infra">
  <div class="layer-inner">
    <Reveal><p class="mono layer-label">4 / Infrastructure</p></Reveal>
    <Reveal delay={0.1}><h2>How it runs</h2></Reveal>
    <Reveal delay={0.15}>
      <p class="layer-intro">
        SPARC's backend runs as Podman containers behind Traefik on a Proxmox VM, with
        GitLab CI for builds and tests. Its Nuxt 4 front-end runs on our OKD cluster,
        deployed through GitOps.
      </p>
    </Reveal>

    <Reveal><div class="infra-grid">
      {sparcInfra.map((item) => (
        <div class="infra-item">
          <span class="mono infra-name">{item.name}</span>
          <p>{item.description}</p>
        </div>
      ))}
    </div></Reveal>

    <Reveal delay={0.1}>
      <div class="gitops-section">
        <h3>Front-end and other services: OKD and GitOps</h3>
        <p class="gitops-intro">
          SPARC's front-end, IRIS, Tandem and Infofin run on an OKD (OpenShift) cluster,
          where merging to main
          <em>is</em> the deployment. Workloads are hardened: read-only root filesystem,
          non-root containers, SCC-constrained pods.
        </p>
        <ol class="gitops-flow">
          <li class="gitops-step">
            <span class="mono gitops-name">Merge</span>
            <p>A merge on main is the only deployment trigger</p>
          </li>
          <li class="gitops-step">
            <span class="mono gitops-name">Tekton</span>
            <p>In-cluster pipelines build and push the images</p>
          </li>
          <li class="gitops-step">
            <span class="mono gitops-name">Argo CD</span>
            <p>Continuously syncs the cluster to the state declared in Git</p>
          </li>
          <li class="gitops-step">
            <span class="mono gitops-name">Kustomize</span>
            <p>Per-environment overlays, no templating drift</p>
          </li>
          <li class="gitops-step">
            <span class="mono gitops-name">Sealed Secrets</span>
            <p>Secrets encrypted at rest in Git, decrypted only in the cluster</p>
          </li>
        </ol>
      </div>
    </Reveal>
  </div>
</section>

<style>
  .layer-label {
    color: var(--layer-infra-label);
    font-size: clamp(0.75rem, 0.7rem + 0.25vw, 0.875rem);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 1.5rem;
  }

  .layer-intro {
    max-width: 48rem;
    margin-bottom: 3rem;
  }

  .infra-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    margin-bottom: 3rem;
  }

  @media (min-width: 769px) {
    .infra-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1100px) {
    .infra-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .infra-item {
    padding: 1.25rem;
    border: 1px solid currentColor;
    border-color: color-mix(in srgb, currentColor 12%, transparent);
    border-radius: 4px;
    transition: border-color 0.3s ease, transform 0.3s ease;
  }

  .infra-item:hover {
    border-color: color-mix(in srgb, currentColor 30%, transparent);
    transform: translateY(-2px);
  }

  .infra-name {
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--layer-infra-label);
    display: block;
    margin-bottom: 0.5rem;
  }

  .infra-item p {
    font-size: 0.875rem;
  }

  .gitops-section h3 {
    margin-bottom: 1rem;
  }

  .gitops-intro {
    max-width: 48rem;
    margin-bottom: 1.5rem;
  }

  .gitops-flow {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    gap: 1rem;
    counter-reset: gitops;
  }

  .gitops-step {
    position: relative;
    padding: 1rem 1rem 1rem 1.1rem;
    border-left: 2px solid var(--layer-infra-accent);
    counter-increment: gitops;
  }

  .gitops-step::before {
    content: counter(gitops, decimal-leading-zero);
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    color: #7a8494;
    display: block;
    margin-bottom: 0.35rem;
  }

  .gitops-name {
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--layer-infra-label);
    display: block;
    margin-bottom: 0.4rem;
  }

  .gitops-step p {
    font-size: 0.85rem;
  }
</style>
