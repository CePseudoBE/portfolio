---
// Layer 4 — Infrastructure: SmartCampus (featured), Proxmox, Docker, SSL/TLS, 4G/5G
import ProjectCard from '../ui/ProjectCard.astro';
import Reveal from '../ui/Reveal.astro';
import { projects } from '../../data/projects';

const sparc = projects.find((p) => p.slug === 'sparc')!;
---

<section class="layer" data-layer="infra" id="infra">
  <div class="layer-inner">
    <Reveal><p class="mono layer-label">4 — Infrastructure</p></Reveal>
    <Reveal delay={0.1}><h2>Infrastructure</h2></Reveal>
    <Reveal delay={0.15}>
      <p class="layer-intro">
        The physical and virtual substrate — and the pipeline that ships to it.
        Production runs on Kubernetes (OKD/OpenShift) behind a full GitOps chain:
        merging to main <em>is</em> the deployment.
      </p>
    </Reveal>

    <Reveal delay={0.2}>
      <div class="featured-project">
        <span class="mono featured-label">Featured project</span>
        <ProjectCard project={sparc} />
      </div>
    </Reveal>

    <Reveal delay={0.1}>
      <div class="gitops-section">
        <h3>GitOps Chain</h3>
        <ol class="gitops-flow">
          <li class="gitops-step">
            <span class="mono gitops-name">Merge</span>
            <p>A merge on main is the only deployment trigger</p>
          </li>
          <li class="gitops-step">
            <span class="mono gitops-name">Tekton</span>
            <p>In-cluster pipelines build and push the images</p>
          </li>
          <li class="gitops-step">
            <span class="mono gitops-name">Argo CD</span>
            <p>Syncs cluster state to the Git repository, continuously</p>
          </li>
          <li class="gitops-step">
            <span class="mono gitops-name">Kustomize</span>
            <p>Per-environment overlays, no templating drift</p>
          </li>
          <li class="gitops-step">
            <span class="mono gitops-name">Sealed Secrets</span>
            <p>Secrets encrypted at rest in Git, decrypted only in-cluster</p>
          </li>
        </ol>
      </div>
    </Reveal>

    <Reveal delay={0.1}><div class="infra-grid">
      <div class="infra-item">
        <span class="mono infra-name">Kubernetes / OKD</span>
        <p>Hardened workloads: readOnlyRootFilesystem, non-root containers, OpenShift SCC-constrained pods.</p>
      </div>
      <div class="infra-item">
        <span class="mono infra-name">Docker</span>
        <p>Containerized microservices with multi-stage builds. Compose for local dev, orchestrated deploys for production.</p>
      </div>
      <div class="infra-item">
        <span class="mono infra-name">Proxmox</span>
        <p>Hypervisor for VM provisioning. Automated templates, resource isolation, snapshot-based rollback.</p>
      </div>
      <div class="infra-item">
        <span class="mono infra-name">LoRaWAN</span>
        <p>Long-range IoT gateway network. Payload decoding, device provisioning, sensor fleet management.</p>
      </div>
    </div></Reveal>
  </div>
</section>

<style>
  .layer-label {
    color: var(--layer-infra-label);
    font-size: clamp(0.75rem, 0.7rem + 0.25vw, 0.875rem);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 1.5rem;
  }

  .layer-intro {
    max-width: 48rem;
    margin-bottom: 3rem;
  }

  .featured-project {
    margin-bottom: 3rem;
  }

  .featured-label {
    display: inline-block;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--layer-infra-label);
    margin-bottom: 1rem;
  }

  .gitops-section {
    margin-bottom: 3rem;
  }

  .gitops-section h3 {
    margin-bottom: 1.25rem;
  }

  .gitops-flow {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    gap: 1rem;
    counter-reset: gitops;
  }

  .gitops-step {
    position: relative;
    padding: 1rem 1rem 1rem 1.1rem;
    border-left: 2px solid var(--layer-infra-accent);
    counter-increment: gitops;
  }

  .gitops-step::before {
    content: counter(gitops, decimal-leading-zero);
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.65rem;
    letter-spacing: 0.08em;
    color: #7a8494;
    display: block;
    margin-bottom: 0.35rem;
  }

  .gitops-name {
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--layer-infra-label);
    display: block;
    margin-bottom: 0.4rem;
  }

  .gitops-step p {
    font-size: 0.85rem;
  }

  .infra-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: 1.5rem;
  }

  .infra-item {
    padding: 1.25rem;
    border: 1px solid currentColor;
    border-color: color-mix(in srgb, currentColor 12%, transparent);
    border-radius: 4px;
    transition: border-color 0.3s ease, transform 0.3s ease;
  }

  .infra-item:hover {
    border-color: color-mix(in srgb, currentColor 30%, transparent);
    transform: translateY(-2px);
  }

  .infra-name {
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--layer-infra-label);
    display: block;
    margin-bottom: 0.5rem;
  }

  .infra-item p {
    font-size: 0.875rem;
  }
</style>
