---
// Layer 1 — Interface: SPARC overview, architecture, how data gets in
import ArchitectureDiagram from '../ui/ArchitectureDiagram.astro';
import MetricBlock from '../ui/MetricBlock.astro';
import Reveal from '../ui/Reveal.astro';
import { sparcConstraints, sparcIngestion, sparcMetrics } from '../../data/sparc';
---

<section class="layer" data-layer="interface" id="interface">
  <div class="layer-inner">
    <Reveal><p class="mono layer-label">1 / Interface</p></Reveal>
    <Reveal delay={0.1}>
      <h2>SPARC, a campus IoT platform</h2>
      <p class="mono sparc-role">Sole engineer, within STARI · Rust backend, Nuxt 4 web app, infrastructure</p>
    </Reveal>
    <Reveal delay={0.15}>
      <div class="layer-intro">
        <p>
          Sensor Platform for Academic Research and Community. In production since
          January 2026 on two ULB campuses, used by a research center (CIREM) and
          ULB's infrastructure department.
        </p>
        <p>
          <strong>The problem:</strong> research and campus teams need reliable sensor
          data, but devices speak different protocols and no team should have to run
          its own pipeline.
        </p>
        <a class="mono sparc-link" href="https://sparc.ulb.be">sparc.ulb.be</a>
      </div>
    </Reveal>

    <div class="overview-grid">
      <Reveal>
        <div>
          <h3>Constraints</h3>
          <ul class="constraints">
            {sparcConstraints.map((constraint) => <li>{constraint}</li>)}
          </ul>
        </div>
      </Reveal>
      <Reveal delay={0.1}>
        <div>
          <h3>By the numbers</h3>
          <div class="metrics-grid">
            {sparcMetrics.map((metric) => <MetricBlock value={metric.value} label={metric.label} />)}
          </div>
        </div>
      </Reveal>
    </div>

    <Reveal>
      <div class="architecture-section">
        <h3>Architecture</h3>
        <ArchitectureDiagram />
      </div>
    </Reveal>

    <Reveal>
      <div>
        <h3>How data gets in</h3>
        <div class="ingestion-grid">
          {sparcIngestion.map((item) => (
            <div class="ingestion-item">
              <span class="mono ingestion-name">{item.name}</span>
              <p>{item.description}</p>
            </div>
          ))}
        </div>
      </div>
    </Reveal>
  </div>
</section>

<style>
  .layer-label {
    color: var(--layer-interface-label);
    font-size: clamp(0.75rem, 0.7rem + 0.25vw, 0.875rem);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 1.5rem;
  }

  .sparc-role {
    margin-top: 0.5rem;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #7a8494;
  }

  .layer-intro {
    max-width: 48rem;
    margin: 1.5rem 0 3rem;
  }

  .layer-intro p {
    margin-bottom: 1rem;
  }

  .layer-intro strong {
    font-weight: 500;
    color: var(--layer-interface-heading);
  }

  .sparc-link {
    color: var(--layer-interface-heading);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  h3 {
    margin-bottom: 1.25rem;
  }

  .overview-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2rem, 1.5rem + 2.5vw, 4rem);
    margin-bottom: 3rem;
  }

  .constraints {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .constraints li {
    position: relative;
    padding-left: 1.25rem;
    font-size: 0.95rem;
  }

  .constraints li::before {
    content: '·' / '';
    position: absolute;
    left: 0.25rem;
    color: var(--layer-interface-label);
  }

  .metrics-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }

  .architecture-section {
    margin-bottom: 3rem;
  }

  .ingestion-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: 1rem;
  }

  .ingestion-item {
    padding: 1.25rem;
    border: 1px solid currentColor;
    border-color: color-mix(in srgb, currentColor 12%, transparent);
    border-radius: 4px;
  }

  .ingestion-name {
    display: block;
    margin-bottom: 0.5rem;
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--layer-interface-label);
  }

  .ingestion-item p {
    font-size: 0.875rem;
  }

  @media (min-width: 769px) {
    .overview-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
