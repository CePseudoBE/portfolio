---
// Layer 3 — Data: SPARC write path and failure handling
import PipelineStep from '../ui/PipelineStep.astro';
import Reveal from '../ui/Reveal.astro';
import { pipelineSteps } from '../../data/pipeline';
import { failureCases } from '../../data/sparc';
---

<section class="layer" data-layer="data" id="data">
  <div class="layer-inner">
    <Reveal><p class="mono layer-label">3 / Data</p></Reveal>
    <Reveal delay={0.1}><h2>Data pipeline and reliability</h2></Reveal>
    <Reveal delay={0.15}>
      <p class="layer-intro">
        Every reading takes the same write path, whatever protocol it arrived on.
        NATS JetStream sits between ingestion and storage, and TimescaleDB keeps
        the time series.
      </p>
    </Reveal>

    <div class="data-content">
      <Reveal><div>
        <h3>Write path, step by step</h3>
        <div class="pipeline-steps">
          {pipelineSteps.map((step, i) => (
            <PipelineStep
              index={i}
              label={step.label}
              description={step.description}
              tech={step.tech}
              total={pipelineSteps.length}
            />
          ))}
        </div>
      </div></Reveal>

      <Reveal delay={0.15}><div>
        <h3>When things go wrong</h3>
        <dl class="failure-list">
          {failureCases.map((failure) => (
            <div class="failure-item">
              <dt class="mono">{failure.scenario}</dt>
              <dd>{failure.behavior}</dd>
            </div>
          ))}
        </dl>
      </div></Reveal>
    </div>
  </div>
</section>

<style>
  .layer-label {
    color: var(--layer-data-label);
    font-size: clamp(0.75rem, 0.7rem + 0.25vw, 0.875rem);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 1.5rem;
  }

  .layer-intro {
    max-width: 48rem;
    margin-bottom: 3rem;
  }

  .data-content {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 1.5rem + 2.5vw, 4rem);
  }

  @media (max-width: 768px) {
    .data-content {
      grid-template-columns: 1fr;
    }
  }

  h3 {
    margin-bottom: 1.25rem;
  }

  .failure-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .failure-item {
    padding: 1rem;
    border: 1px solid currentColor;
    border-color: color-mix(in srgb, currentColor 12%, transparent);
    border-radius: 4px;
  }

  .failure-item dt {
    display: block;
    margin-bottom: 0.35rem;
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--layer-data-label);
  }

  .failure-item dd {
    font-size: 0.875rem;
  }
</style>
