---
// Layer 3 — Data: Pipelines, databases, schema design
import PipelineStep from '../ui/PipelineStep.astro';
import MetricBlock from '../ui/MetricBlock.astro';
import Reveal from '../ui/Reveal.astro';
import { pipelineSteps } from '../../data/pipeline';
---

<section class="layer" data-layer="data" id="data">
  <div class="layer-inner">
    <Reveal><p class="mono layer-label">3 — Data</p></Reveal>
    <Reveal delay={0.1}><h2>Data Layer</h2></Reveal>
    <Reveal delay={0.15}>
      <p class="layer-intro">
        From external APIs to NGSI-LD entities. Collectors ingest, Harvesters transform,
        Redis caches, PostgreSQL persists — with BullMQ orchestrating the flow
        and presigned URLs for heavy assets.
      </p>
    </Reveal>

    <div class="data-content">
      <Reveal><div class="pipeline-section">
        <h3>Pipeline</h3>
        <div class="pipeline-steps">
          {pipelineSteps.map((step, i) => (
            <PipelineStep
              index={i}
              label={step.label}
              description={step.description}
              tech={step.tech}
              total={pipelineSteps.length}
            />
          ))}
        </div>
      </div></Reveal>

      <Reveal delay={0.15}><div class="data-sidebar">
        <div class="metrics-section">
          <h3>At Scale</h3>
          <div class="metrics-grid">
            <MetricBlock value="9" label="Monorepo packages" />
            <MetricBlock value="4" label="Dependency layers" />
            <MetricBlock value="4" label="BullMQ queues" />
            <MetricBlock value="~60%" label="Overhead reduction" />
          </div>
        </div>

        <div class="db-section">
          <h3>Storage</h3>
          <div class="db-list">
            <div class="db-item">
              <span class="mono db-name">PostgreSQL</span>
              <p>Metadata, user ownership, subscriptions, historical entity data</p>
            </div>
            <div class="db-item">
              <span class="mono db-name">Redis</span>
              <p>Entity last-state cache, subscription cache, BullMQ queues, pub/sub</p>
            </div>
            <div class="db-item">
              <span class="mono db-name">BullMQ</span>
              <p>4 priority queues — collectors, harvesters, priority jobs, uploads</p>
            </div>
            <div class="db-item">
              <span class="mono db-name">OVH S3</span>
              <p>Raw files, 3D assets, tilesets — presigned URL upload for large files</p>
            </div>
          </div>
        </div>
      </div></Reveal>
    </div>
  </div>
</section>

<style>
  .layer-label {
    color: var(--layer-data-accent);
    font-size: clamp(0.75rem, 0.7rem + 0.25vw, 0.875rem);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 1.5rem;
  }

  .layer-intro {
    max-width: 48rem;
    margin-bottom: 3rem;
  }

  .data-content {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 1.5rem + 2.5vw, 4rem);
  }

  @media (max-width: 768px) {
    .data-content {
      grid-template-columns: 1fr;
    }
  }

  .pipeline-section h3,
  .data-sidebar h3 {
    margin-bottom: 1.25rem;
  }

  .metrics-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    margin-bottom: 2.5rem;
  }

  .db-section {
    margin-top: 0.5rem;
  }

  .db-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .db-item {
    padding: 1rem;
    border: 1px solid currentColor;
    transition: border-color 0.3s ease, transform 0.3s ease;
    border-color: color-mix(in srgb, currentColor 12%, transparent);
    border-radius: 4px;
  }

  .db-item:hover {
    border-color: color-mix(in srgb, currentColor 30%, transparent);
    transform: translateY(-2px);
  }

  .db-name {
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--layer-data-accent);
    display: block;
    margin-bottom: 0.35rem;
  }

  .db-item p {
    font-size: 0.85rem;
    opacity: 0.7;
  }
</style>
