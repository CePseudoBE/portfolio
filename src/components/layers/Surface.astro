---
// Layer 0 — Surface: Hero, name, tagline, intro
import TechPill from '../ui/TechPill.astro';
import Reveal from '../ui/Reveal.astro';
import { skills } from '../../data/skills';
---

<section class="layer" data-layer="surface" id="surface">
  <div class="layer-inner surface-layout">
    <div class="surface-content">
      <Reveal><p class="mono layer-label">0 — Surface</p></Reveal>
      <Reveal delay={0.1}><h1 class="hero-name">Axel<br />Hoffmann</h1></Reveal>
      <Reveal delay={0.25}><p class="hero-title">Backend Engineer</p></Reveal>
      <Reveal delay={0.35}>
        <p class="hero-meta mono">STARI — ULB & FARI · Brussels · 2023 — present</p>
      </Reveal>
      <Reveal delay={0.4}>
        <p class="tagline">
          Distributed systems, IoT platforms, and the invisible
          infrastructure that makes things work.
        </p>
      </Reveal>
      <Reveal delay={0.55}>
        <div class="surface-stack">
          {skills.map((cat, i) => (
            <div class="stack-group">
              <span class="mono stack-label">{cat.label}</span>
              <div class="stack-items">
                {cat.items.map((item) => <TechPill label={item} />)}
              </div>
            </div>
          ))}
        </div>
      </Reveal>
    </div>
    <div class="scroll-hint mono">
      <span>scroll to descend</span>
      <svg width="16" height="24" viewBox="0 0 16 24" fill="none" aria-hidden="true">
        <path d="M8 4L8 20M8 20L2 14M8 20L14 14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </div>
  </div>
</section>

<style>
  .layer-label {
    color: var(--layer-surface-accent);
    font-size: clamp(0.75rem, 0.7rem + 0.25vw, 0.875rem);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 1.5rem;
  }

  .hero-name {
    font-family: 'Instrument Serif', Georgia, serif;
    font-size: clamp(3.5rem, 2.5rem + 5vw, 7rem);
    line-height: 0.95;
    letter-spacing: -0.02em;
    color: var(--layer-surface-heading);
    margin-bottom: 1rem;
  }

  .hero-title {
    font-family: 'IBM Plex Mono', monospace;
    font-size: clamp(0.85rem, 0.8rem + 0.25vw, 1rem);
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--layer-surface-accent);
    margin-bottom: 0.5rem;
  }

  .hero-meta {
    font-size: clamp(0.7rem, 0.65rem + 0.2vw, 0.8rem);
    letter-spacing: 0.06em;
    color: #7a8494;
    margin-bottom: 1.5rem;
  }

  .surface-layout {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: calc(100vh - 8rem);
  }

  .surface-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .tagline {
    font-size: clamp(1.05rem, 1rem + 0.25vw, 1.25rem);
    max-width: 36rem;
    line-height: 1.7;
  }

  .surface-stack {
    margin-top: 3rem;
    display: flex;
    flex-wrap: wrap;
    gap: 2rem;
  }

  .stack-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .stack-label {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #7a8494;
  }

  .stack-items {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  /* Nested wrapping flex rows overflow the viewport on narrow screens
     (the group's intrinsic width is its unwrapped pill row) */
  @media (max-width: 768px) {
    .surface-stack {
      flex-direction: column;
      gap: 1.5rem;
    }

    .stack-group {
      width: 100%;
    }
  }

  .scroll-hint {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #7a8494;
    padding-top: 2rem;
  }

  .scroll-hint svg {
    animation: bounce 2s ease-in-out infinite;
  }

  @keyframes bounce {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(6px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .scroll-hint svg {
      animation: none;
    }
  }
</style>
