---
// Layer 0 — Surface: hero, positioning, calls to action
import TechPill from '../ui/TechPill.astro';
import { heroStack } from '../../data/skills';
import { contact } from '../../data/contact';
---

<section class="layer" data-layer="surface" id="surface">
  <div class="layer-inner surface-layout">
    <div class="surface-content">
      <p class="mono layer-label">0 / Surface</p>
      <h1 class="hero-name">Axel<br />Hoffmann</h1>
      <p class="hero-title">Backend Engineer · Rust &amp; TypeScript</p>
      <p class="hero-meta mono">
        3 years building production systems at Université libre de Bruxelles (ULB) · Brussels
      </p>
      <p class="hero-availability mono">Open to remote roles in the EU</p>
      <p class="lead">
        As the sole engineer, I designed, built and now run <a href="#interface">SPARC</a>,
        the IoT platform collecting sensor data on two ULB campuses: Rust, NATS JetStream
        and TimescaleDB, from ingestion to infrastructure.
      </p>
      <div class="hero-actions">
        <a href="#interface" class="button button-primary mono">Read the SPARC case study</a>
        <a href={`mailto:${contact.email}`} class="button mono">Email me</a>
        <a href={contact.cv} class="button mono">CV (PDF)</a>
      </div>
      <p class="hero-social mono">
        <a href={contact.github}>GitHub</a> · <a href={contact.linkedin}>LinkedIn</a>
      </p>
      <div class="hero-stack">
        {heroStack.map((item) => <TechPill label={item} />)}
      </div>
    </div>
    <div class="scroll-hint mono">
      <span>scroll to descend</span>
      <svg width="16" height="24" viewBox="0 0 16 24" fill="none" aria-hidden="true">
        <path d="M8 4L8 20M8 20L2 14M8 20L14 14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </div>
  </div>
</section>

<style>
  .layer-label {
    color: var(--layer-surface-accent);
    font-size: clamp(0.75rem, 0.7rem + 0.25vw, 0.875rem);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 1.5rem;
  }

  .hero-name {
    font-family: 'Instrument Serif', Georgia, serif;
    font-size: clamp(3.5rem, 2.5rem + 5vw, 7rem);
    line-height: 0.95;
    letter-spacing: -0.02em;
    color: var(--layer-surface-heading);
    margin-bottom: 1rem;
  }

  .hero-title {
    font-family: 'IBM Plex Mono', monospace;
    font-size: clamp(0.85rem, 0.8rem + 0.25vw, 1rem);
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--layer-surface-accent);
    margin-bottom: 0.5rem;
  }

  .hero-meta {
    font-size: clamp(0.75rem, 0.7rem + 0.2vw, 0.85rem);
    letter-spacing: 0.04em;
    color: #7a8494;
  }

  .hero-availability {
    font-size: clamp(0.75rem, 0.7rem + 0.2vw, 0.85rem);
    letter-spacing: 0.04em;
    color: var(--layer-surface-heading);
    margin-bottom: 1.5rem;
  }

  .surface-layout {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: calc(100vh - 8rem);
  }

  .surface-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .lead {
    font-size: clamp(1.05rem, 1rem + 0.25vw, 1.25rem);
    max-width: 40rem;
    line-height: 1.7;
  }

  .lead a,
  .hero-social a {
    color: var(--layer-surface-heading);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .button-primary {
    background-color: var(--layer-surface-heading);
    border-color: var(--layer-surface-heading);
    color: var(--layer-surface-bg);
  }

  .button-primary:hover {
    background-color: var(--layer-surface-text);
  }

  .hero-social {
    margin-top: 1.25rem;
    font-size: 0.85rem;
  }

  .hero-stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 2.5rem;
  }

  .scroll-hint {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #7a8494;
    padding-top: 2rem;
  }

  .scroll-hint svg {
    animation: bounce 2s ease-in-out infinite;
  }

  @keyframes bounce {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(6px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .scroll-hint svg {
      animation: none;
    }
  }
</style>
