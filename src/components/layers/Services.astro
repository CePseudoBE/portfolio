---
// Layer 2 — Services: SPARC architecture and key decisions
import PatternCard from '../ui/PatternCard.astro';
import Reveal from '../ui/Reveal.astro';
import { sparcDecisions, sparcFeatures } from '../../data/sparc';
---

<section class="layer" data-layer="services" id="services">
  <div class="layer-inner">
    <Reveal><p class="mono layer-label">2 / Services</p></Reveal>
    <Reveal delay={0.1}><h2>Architecture and key decisions</h2></Reveal>
    <Reveal delay={0.15}>
      <p class="layer-intro">
        A modular monolith in Rust: hexagonal architecture (ports and adapters), an
        event-driven ingestion pipeline, and a light CQRS split between the write path
        and the read path.
      </p>
    </Reveal>

    <Reveal>
      <div class="decisions-section">
        <h3>Decisions and trade-offs</h3>
        <div class="decisions-grid">
          {sparcDecisions.map((decision) => (
            <PatternCard name={decision.name} description={decision.description} />
          ))}
        </div>
      </div>
    </Reveal>

    <Reveal>
      <div>
        <h3>What it does</h3>
        <ul class="features-list">
          {sparcFeatures.map((feature) => <li>{feature}</li>)}
        </ul>
      </div>
    </Reveal>
  </div>
</section>

<style>
  .layer-label {
    color: var(--layer-services-label);
    font-size: clamp(0.75rem, 0.7rem + 0.25vw, 0.875rem);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 1.5rem;
  }

  .layer-intro {
    max-width: 48rem;
    margin-bottom: 3rem;
  }

  h3 {
    margin-bottom: 1.25rem;
  }

  .decisions-section {
    margin-bottom: 3rem;
  }

  .decisions-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
    gap: 1rem;
  }

  .features-list {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr));
    gap: 0.75rem 2rem;
  }

  .features-list li {
    padding-left: 1rem;
    border-left: 2px solid var(--layer-services-accent);
    font-size: 0.95rem;
  }
</style>
