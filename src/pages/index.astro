---
import Layout from '../layouts/Layout.astro';
import Header from '../components/sections/Header.astro';
import Intro from '../components/sections/Intro.astro';
import Sparc from '../components/sections/Sparc.astro';
import Architecture from '../components/sections/Architecture.astro';
import Reliability from '../components/sections/Reliability.astro';
import Infrastructure from '../components/sections/Infrastructure.astro';
import OtherWork from '../components/sections/OtherWork.astro';
import About from '../components/sections/About.astro';
import Contact from '../components/sections/Contact.astro';
---

<Layout>
  <a href="#main" class="skip-link">
    Skip to content
  </a>
  <Header />
  <main id="main">
    <Intro />
    <Sparc />
    <Architecture />
    <Reliability />
    <Infrastructure />
    <OtherWork />
    <About />
    <Contact />
  </main>
  <footer>Built with Astro</footer>
</Layout>
