---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page not found | Axel Hoffmann">
  <main id="main">
    <h1>Page not found.</h1>
    <p>This page does not exist. The whole portfolio lives on a single page.</p>
    <p>
      <a href="/">Back to the home page</a>
    </p>
  </main>
</Layout>

<style>
  main {
    max-width: 1280px;
    margin: 0 auto;
    padding: 32px 16px;
  }

  @media (min-width: 900px) {
    main {
      padding: 56px 40px;
    }
  }

  h1 {
    font-stretch: 72%;
    font-weight: 750;
    font-size: 2.625rem;
    line-height: 1;
  }
</style>
