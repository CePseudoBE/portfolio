---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Axel Hoffmann | Backend Engineer (Rust, TypeScript)',
  description = 'Backend engineer (Rust, TypeScript) in Brussels. Built SPARC, a production IoT data platform at ULB. Open to remote roles in the EU.',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
// LinkedIn's CDN caches the image by source URL, so a re-rendered
// image must ship under a new filename to bust that cache.
const ogImage = new URL('/og-axel-hoffmann.png', Astro.site);

import '../styles/global.css';
import archivoLatin from '@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url';

const archivoFontFace = `@font-face{font-family:Archivo;font-style:normal;font-display:swap;font-weight:100 900;font-stretch:62% 125%;src:url(${archivoLatin}) format('woff2-variations')}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#141414" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonical} />
    <link rel="preload" href={archivoLatin} as="font" type="font/woff2" crossorigin />
    <style is:inline set:html={archivoFontFace} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Axel Hoffmann" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Axel Hoffmann, backend engineer. Built SPARC, a production IoT platform in Rust."
    />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
