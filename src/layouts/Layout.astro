---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Axel Hoffmann | Backend Engineer',
  description = 'Backend engineer at STARI (ULB & FARI), Brussels. Rust, TypeScript, distributed systems, Kubernetes/GitOps. Building what runs beneath the surface.',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
// v2 filename: LinkedIn's CDN caches the image by source URL, so a
// re-rendered image must ship under a new path to bust that cache.
const ogImage = new URL('/og-card.png', Astro.site);

import '../styles/global.css';
import '../styles/layers.css';

// Self-hosted fonts — no external requests, latin subsets only
import '@fontsource/instrument-serif/latin-400.css';
import '@fontsource/ibm-plex-mono/latin-400.css';
import '@fontsource/ibm-plex-mono/latin-500.css';
import '@fontsource/manrope/latin-400.css';
import '@fontsource/manrope/latin-500.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0c1018" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Axel Hoffmann" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
